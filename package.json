{
	"name": "turbosync",
	"version": "0.0.1",
	"description": "CLI tool for integrating external repositories into Turborepo workspaces",
	"main": "dist/index.js",
	"private": true,
	"type": "module",
	"bin": {
		"turbosync": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"build:os": "bun build --compile src/index.ts --outfile dist/turbosync --target bun-darwin-x64",
		"check-types": "tsc --noEmit",
		"lint": "bunx biome lint --write .",
		"lint:fix": "bunx biome check --write .",
		"dev": "bun --hot src/index.ts",
		"postbuild": "chmod +x dist/index.js",
		"setup": "./scripts/install-dev.sh",
		"link": "bun run build && bun link",
		"test": "bun test"
	},
	"dependencies": {
		"@clack/prompts": "^0.11.0",
		"chalk": "^5.6.2",
		"commander": "^14.0.1",
		"execa": "^9.6.0",
		"fs-extra": "^11.3.2",
		"ora": "^9.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.4",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.5.2",
		"typescript": "^5.9.2",
		"@types/bun": "latest"
	}
}
