{
  "name": "@claudiusmaximus/turbosync",
  "version": "0.0.1",
  "description": "CLI tool for integrating external repositories into TurboRepo workspaces",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "turbosync": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "postbuild": "chmod +x dist/index.js",
    "setup": "./scripts/install-dev.sh",
    "install-global": "npm run build && npm link"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.13.1"
}