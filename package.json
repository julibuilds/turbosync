{
  "name": "turbosync",
  "version": "0.0.1",
  "description": "CLI tool for integrating external repositories into Turborepo workspaces",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "bin": {
    "turbosync": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build --compile src/index.ts --outfile dist/turbosync --target bun-darwin-x64",
    "check-types": "tsc --noEmit",
    "lint": "bunx biome lint --write .",
    "postbuild": "chmod +x dist/index.js",
    "setup": "./scripts/install-dev.sh",
    "link": "bun run build && bun link",
    "test": "bun test"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.2",
    "ora": "^9.0.0",
    "simple-git": "^3.30.0",
    "tmp-promise": "^3.0.3",
    "zod": "^4.1.12",
    "zx": "^8.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "@types/bun": "^1.3.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@types/tmp": "^0.2.6",
    "typescript": "^5.9.3"
  }
}
